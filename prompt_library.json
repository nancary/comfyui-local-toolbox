{
  "version": 1,
  "_comment": "灵感积木词库：分层标签块 + 底模提示词档案 + 成熟风格配方。blocks.items.t 为拼进提示词的文本；zh 为中文说明；hot=true 表示显性高效词（实测/社区公认出效果）；bases 为仅适用的底模（缺省=通用）。",
  "bases": {
    "zimage": {
      "name": "Z-Image Turbo",
      "syntax": "natural",
      "supports_cn": true,
      "weight_syntax": "none",
      "tips": [
        "中文/英文混用都行，自然语言短句最稳",
        "不需要质量词堆砌——精简四要素：主体 + 动作 + 光影 + 场景",
        "cfg=1 时负面提示词无效，negative 不用写",
        "8-9 步秒级出图，写实摄影质感是它的强项"
      ],
      "default_neg": "",
      "params": { "steps": 9, "cfg": 1.0, "sampler": "euler", "scheduler": "simple" }
    },
    "krea2": {
      "name": "Krea2",
      "syntax": "natural",
      "supports_cn": true,
      "weight_syntax": "none",
      "tips": [
        "自然语言整句描述效果最好，像跟摄影师下单一样写",
        "不堆质量词；描述越具体（镜头/光线/情绪）越稳",
        "FP8 精度 Turbo 模式 12 步"
      ],
      "default_neg": "",
      "params": { "steps": 12, "cfg": 1.0, "sampler": "euler", "scheduler": "simple" }
    },
    "flux1": {
      "name": "FLUX",
      "syntax": "natural",
      "supports_cn": false,
      "weight_syntax": "none",
      "tips": [
        "用完整的英文句子描述画面，而不是堆标签",
        "不要质量词、不要负面词——它靠文本对齐吃饭",
        "文字渲染能力强，可以让画面里出现牌子/招牌文字"
      ],
      "default_neg": "",
      "params": { "steps": 20, "cfg": 3.5, "sampler": "euler", "scheduler": "simple" }
    },
    "anima": {
      "name": "Anima",
      "syntax": "hybrid",
      "supports_cn": true,
      "weight_syntax": "paren",
      "tips": [
        "qwen3 文本编码器：中文自然语言和 Danbooru 标签都吃",
        "动画/插画渲染向，写实词会拉低出片率",
        "约 20 步 / cfg 4，负面词有效"
      ],
      "default_neg": "lowres, bad anatomy, bad hands, watermark",
      "params": { "steps": 20, "cfg": 4.0, "sampler": "euler_ancestral", "scheduler": "simple" }
    },
    "illustrious": {
      "name": "Illustrious",
      "syntax": "danbooru",
      "supports_cn": false,
      "weight_syntax": "paren",
      "tips": [
        "Danbooru 标签体系：逗号分隔的英文标签，越精确越好",
        "质量词开头（masterpiece, best quality）有明显影响",
        "支持 (tag:1.2) 分数权重，给关键标签加权",
        "负面词有效：把不想要的元素写进 negative"
      ],
      "default_neg": "lowres, bad anatomy, bad hands, extra fingers, watermark, text",
      "params": { "steps": 28, "cfg": 5.0, "sampler": "euler", "scheduler": "simple" }
    },
    "sdxl": {
      "name": "SDXL",
      "syntax": "danbooru",
      "supports_cn": false,
      "weight_syntax": "paren",
      "tips": [
        "标签+自然语言混合都行，Danbooru 标签最稳",
        "质量词对出图影响明显",
        "支持 (tag:1.2) 分数权重"
      ],
      "default_neg": "lowres, bad anatomy, bad hands, watermark, text",
      "params": { "steps": 28, "cfg": 5.5, "sampler": "dpmpp_2m", "scheduler": "karras" }
    },
    "pony": {
      "name": "Pony",
      "syntax": "danbooru",
      "supports_cn": false,
      "weight_syntax": "paren",
      "tips": [
        "必须带 score_9, score_8_up, score_7_up 开头才正常发挥",
        "Danbooru 标签；负面词有效（score_6 系放 negative）",
        "y2k/欧美向语料多，中式题材靠标签硬写"
      ],
      "default_neg": "score_6, score_5, score_4, lowres, bad anatomy, watermark",
      "params": { "steps": 26, "cfg": 6.0, "sampler": "euler", "scheduler": "simple" }
    }
  },
